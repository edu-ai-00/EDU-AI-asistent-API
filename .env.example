APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="edu@dev.nobig.deals"
MAIL_FROM_NAME="EduAI"

RESEND_API_KEY=

# Cloudflare R2 Storage (S3-compatible)
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=eduai
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_URL=https://pub-<HASH>.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Admin emails (comma-separated)
ADMIN_EMAILS=
ADMIN_API_KEY=

# Google OAuth — accepted id_token audiences (comma-separated client IDs:
# Web, iOS, Android). Used by POST /api/auth/google to verify sign-ins.
GOOGLE_CLIENT_IDS=

# Apple Sign In — accepted identity-token audiences (comma-separated): the
# native iOS bundle ID (com.eduai.eduaiapp) and, for web, the Services ID.
APPLE_CLIENT_IDS=

# Microsoft (Entra ID) — accepted id_token audiences (comma-separated app
# client IDs) and tenant (GUID, or common/organizations/consumers). The tenant
# must match the app's aad_oauth config.
MICROSOFT_CLIENT_IDS=
MICROSOFT_TENANT=common

# AI Chat (OpenRouter)
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o
AI_MAX_TOKENS=2048
AI_MAX_CONTEXT=128000
