APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Nightwatch — one token per Nightwatch environment (stage ≠ prod).
# start.sh runs the agent only when the token is set; defaults (redaction,
# deploy SHA, server name) live in config/nightwatch.php.
# To ship logs too, deployed envs use LOG_CHANNEL=stack + LOG_STACK=stderr,nightwatch.
NIGHTWATCH_TOKEN=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="edu@dev.nobig.deals"
MAIL_FROM_NAME="EduAI"

RESEND_API_KEY=

# Cloudflare R2 Storage (S3-compatible)
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=eduai
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_URL=https://pub-<HASH>.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Admin emails (comma-separated)
ADMIN_EMAILS=
ADMIN_API_KEY=

# Google OAuth — accepted id_token audiences (comma-separated client IDs:
# Web, iOS, Android). Used by POST /api/auth/google to verify sign-ins.
GOOGLE_CLIENT_IDS=

# Apple Sign In — accepted identity-token audiences (comma-separated): the
# native iOS bundle ID (com.eduai.eduaiapp) and, for web, the Services ID.
APPLE_CLIENT_IDS=

# Microsoft (Entra ID) — accepted id_token audiences (comma-separated app
# client IDs) and tenant (GUID, or common/organizations/consumers). The tenant
# must match the app's aad_oauth config.
MICROSOFT_CLIENT_IDS=
MICROSOFT_TENANT=common

# AI Chat (OpenRouter)
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o
AI_MAX_TOKENS=2048
AI_MAX_CONTEXT=128000

# RAG search — used by mentors with engine=rag (see /admin/mentors)
RAG_BASE_URL=https://rag2.edu-ai.eu/search/v1
# Cloudflare Access service token (Zero Trust in front of the RAG service).
# This is the auth the provider wants (BR-DAB49K); the service key below is
# legacy and can stay empty once the token is set.
RAG_CF_ACCESS_CLIENT_ID=
RAG_CF_ACCESS_CLIENT_SECRET=
RAG_API_KEY=
RAG_TIMEOUT=120
# Default documents to search. Each mentor can override it with its own
# legal entity in the admin; this is the fallback for the ones that don't.
RAG_LEGAL_ENTITY=ZS_KAVCI_HORY_ZS

# Open-answer AI evaluation (BR-FFVVYR). AI_EVAL_MODEL falls back to AI_MODEL.
AI_EVAL_MODEL=
# Raised from 400 by BR-P745Q8: three-part feedback plus up to four criteria no
# longer fits, and a truncated JSON body is discarded as unparseable.
AI_EVAL_MAX_TOKENS=900
AI_EVAL_TIMEOUT=20
# Internal only — the student never sees this score or any pass/fail verdict.
# It drives the teacher view, ELO and FSRS.
AI_EVAL_PASS_THRESHOLD=0.7
# BR-DF88P7: answer the question locally when the student's text already
# matches `correct_answer`. Set to false to send every answer to the model.
AI_EVAL_EXACT_MATCH=true

# Formative feedback + photographed answers (BR-P745Q8).
# Stamped onto every attempt so a prompt rewrite stays auditable. Bump when the
# prompt or the response contract changes.
AI_EVAL_PROMPT_VERSION=p745q8-v4
# Vision model for photographed answers. Falls back to AI_OCR_MODEL below.
AI_EVAL_VISION_MODEL=
AI_EVAL_VISION_MAX_TOKENS=1400
AI_EVAL_VISION_TIMEOUT=45
AI_EVAL_PHOTO_MAX_BYTES=8388608

# AI Course Assistant — generate course content from photos/PDFs (BR-D4PE8R).
# Reuses AI_API_KEY / AI_API_URL above; only the models differ.
AI_OCR_MODEL=google/gemini-3.7-flash
AI_GEN_MODEL=anthropic/claude-sonnet-5
# PDF parsing engine: native | mistral-ocr | cloudflare-ai
# Keep `native` — OpenRouter's own default (mistral-ocr) costs ~$2/1000 pages
# and is worse on handwriting. See config/generation.php.
AI_PDF_ENGINE=native
AI_GEN_MAX_TOKENS=16000
AI_GEN_TTL_MINUTES=15
AI_GEN_MAX_ATTACHMENTS=10
AI_GEN_MAX_FILE_BYTES=15728640
# Public URL of the admin app — the QR code points at {ADMIN_APP_URL}/capture/{token}.
# REQUIRED, no fallback: a session cannot be issued without it, on purpose. A
# wrong value yields a QR code that scans fine and opens nothing.
# Also builds the sign-in link in the invitation mailed to a new teacher or
# admin (BR-38FYMX) — unset, the account is still created but nothing is sent.
ADMIN_APP_URL=https://app-admin-stage.edu-ai.eu

# Server-side task difficulty calibration (BR-697NCA). Off by default: answers
# are logged but move no task difficulty, the app keeps the course's own
# elo_vector, and the nightly elo:recalibrate does not run. Run
# `php artisan elo:recalibrate` once before switching it on.
ELO_TASK_CALIBRATION=false
